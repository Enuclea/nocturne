SKY_PORT=8088
# Set an operator contact before hosting a shared/public instance.
# JPL_USER_AGENT=Nocturne/1.0 (https://nocturne.vespertinum.com; contact: your-email@example.com)
# Behind Cloudflare, rate-limit visitors by their real address (CF-Connecting-IP).
# Only enable when the server is reachable solely through Cloudflare (for example, a Cloudflare
# Tunnel, or a firewall that admits only Cloudflare's IP ranges); otherwise the header can be faked.
# TRUST_CLOUDFLARE=true
